[Unit]
Description=Tape Lounge market-aware AI crew
After=network-online.target llama-server.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/shyoo/tape-lounge
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TAPE_AI_CHAT_ENABLE=1
Environment=TAPE_AI_CHAT_SIGNING_KEY=/home/shyoo/.config/tape-lounge/lounge-crew-signing-key.pem
ExecStart=/usr/bin/python3 /home/shyoo/tape-lounge/scripts/lounge_crew.py --publish
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/shyoo/.local/state/tape-lounge
MemoryMax=500M
CPUQuota=50%
TimeoutStartSec=10min
